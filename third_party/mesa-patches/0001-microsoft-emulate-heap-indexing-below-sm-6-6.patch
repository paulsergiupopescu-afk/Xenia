+   bool heap_emulation;
+   unsigned heap_emulation_space_base;
+   /* Sizes of the emulation ranges, 0 for unbounded ones. Some drivers handle
+    * ranges of the size of the heap better than unbounded ones. */
+   unsigned heap_emulation_srv_count;
+   unsigned heap_emulation_sampler_count;
 };
 
