+struct heap_range {
+   enum dxil_resource_class res_class;
+   /* dxil_resource_kind for SRVs, dxil_sampler_kind for samplers. */
+   unsigned kind;
+   enum dxil_component_type comp_type;
+   unsigned space;
+   unsigned range_id;
+};
+
+static enum dxil_component_type
+heap_emulation_comp_type(nir_alu_type type)
+{
+   switch (type & NIR_ALU_TYPE_BASE_TYPE_MASK) {
+   case nir_type_int: return DXIL_COMP_TYPE_I32;
+   case nir_type_uint: return DXIL_COMP_TYPE_U32;
+   default: return DXIL_COMP_TYPE_F32;
+   }
+}
+
+/* Queries don't depend on the declared component type, so they reuse the
+ * float ranges rather than requiring ranges of their result type. */
+static enum dxil_component_type
+heap_emulation_tex_comp_type(const nir_tex_instr *tex)
+{
+   switch (tex->op) {
+   case nir_texop_txs:
+   case nir_texop_query_levels:
+   case nir_texop_texture_samples:
+      return DXIL_COMP_TYPE_F32;
+   default:
+      return heap_emulation_comp_type(tex->dest_type);
+   }
+}
+
+static struct heap_range *
+find_heap_range(struct ntd_context *ctx, enum dxil_resource_class res_class,
+                unsigned kind, enum dxil_component_type comp_type)
+{
+   util_dynarray_foreach(&ctx->heap_ranges, struct heap_range, range) {
+      if (range->res_class == res_class && range->kind == kind &&
+          range->comp_type == comp_type)
+         return range;
+   }
+   return NULL;
+}
+
+static void
+record_heap_range(struct ntd_context *ctx, enum dxil_resource_class res_class,
+                  unsigned kind, enum dxil_component_type comp_type)
+{
+   if (find_heap_range(ctx, res_class, kind, comp_type))
+      return;
+   /* Must match dxil_spirv_heap_emulation_srv_space and
+    * dxil_spirv_heap_emulation_sampler_space. */
+   unsigned base = ctx->opts->heap_emulation_space_base;
+   struct heap_range range = {
+      .res_class = res_class,
+      .kind = kind,
+      .comp_type = comp_type,
+      .space = res_class == DXIL_RESOURCE_CLASS_SAMPLER
+                  ? base + (kind == DXIL_SAMPLER_KIND_COMPARISON ? 1 : 0)
+                  : base + kind * 32 + comp_type,
+      .range_id = ~0u,
+   };
+   util_dynarray_append(&ctx->heap_ranges, range);
+}
+
+static unsigned
+heap_emulation_sampler_kind(bool is_shadow)
+{
+   return is_shadow ? DXIL_SAMPLER_KIND_COMPARISON : DXIL_SAMPLER_KIND_DEFAULT;
+}
+
+/* Collect the ranges needed before emitting resources, as the validator wants
+ * them declared per class (CBVs, samplers, SRVs, UAVs) before the code. */
+static bool
+gather_heap_emulation_ranges(struct ntd_context *ctx)
+{
+   if (!ctx->heap_emulation)
+      return true;
+
+   nir_foreach_function_impl(impl, ctx->shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic) {
+               switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+               case nir_intrinsic_bindless_image_load:
+               case nir_intrinsic_bindless_image_store:
+               case nir_intrinsic_bindless_image_atomic:
+               case nir_intrinsic_bindless_image_atomic_swap:
+               case nir_intrinsic_bindless_image_size:
+                  log_nir_instr_unsupported(
+                     ctx->logger, "Bindless image without Shader Model 6.6",
+                     instr);
+                  return false;
+               default:
+                  break;
+               }
+               continue;
+            }
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            if (nir_tex_instr_src_index(tex, nir_tex_src_texture_handle) >= 0)
+               record_heap_range(ctx, DXIL_RESOURCE_CLASS_SRV,
+                                 dxil_sampler_dim_to_resource_kind(tex->sampler_dim,
+                                                                   tex->is_array),
+                                 heap_emulation_tex_comp_type(tex));
+            if (nir_tex_instr_src_index(tex, nir_tex_src_sampler_handle) >= 0 &&
+                nir_tex_instr_need_sampler(tex))
+               record_heap_range(ctx, DXIL_RESOURCE_CLASS_SAMPLER,
+                                 heap_emulation_sampler_kind(tex->is_shadow),
+                                 DXIL_COMP_TYPE_INVALID);
+         }
+      }
+   }
+   return true;
+}
+
+static bool
+emit_heap_emulation_ranges(struct ntd_context *ctx,
+                           enum dxil_resource_class res_class)
+{
+   /* 0 means unbounded. */
+   unsigned count = res_class == DXIL_RESOURCE_CLASS_SAMPLER
+                       ? ctx->opts->heap_emulation_sampler_count
+                       : ctx->opts->heap_emulation_srv_count;
+   unsigned layout_size = count ? count : UINT_MAX;
+   util_dynarray_foreach(&ctx->heap_ranges, struct heap_range, range) {
+      if (range->res_class != res_class)
+         continue;
+      if (res_class == DXIL_RESOURCE_CLASS_SAMPLER) {
+         unsigned id = util_dynarray_num_elements(&ctx->sampler_metadata_nodes,
+                                                  const struct dxil_mdnode *);
+         resource_array_layout layout = {id, 0, layout_size, range->space};
+         const struct dxil_type *int32_type = dxil_module_get_int_type(&ctx->mod, 32);
+         const struct dxil_type *sampler_type =
+            dxil_module_get_struct_type(&ctx->mod, "struct.SamplerState", &int32_type, 1);
+         sampler_type = dxil_module_get_array_type(&ctx->mod, sampler_type, count);
+         const struct dxil_mdnode *fields[8];
+         fill_resource_metadata(&ctx->mod, fields, sampler_type, "heap_samplers", &layout);
+         fields[6] = dxil_get_metadata_int32(&ctx->mod, range->kind); // sampler kind
+         fields[7] = NULL; // metadata
+         const struct dxil_mdnode *sampler_meta =
+            dxil_get_metadata_node(&ctx->mod, fields, ARRAY_SIZE(fields));
+         if (!sampler_meta)
+            return false;
+         util_dynarray_append(&ctx->sampler_metadata_nodes, sampler_meta);
+         add_resource(ctx, DXIL_RES_SAMPLER, DXIL_RESOURCE_KIND_SAMPLER, &layout);
+         range->range_id = id;
+      } else {
+         assert(res_class == DXIL_RESOURCE_CLASS_SRV);
+         unsigned id = util_dynarray_num_elements(&ctx->srv_metadata_nodes,
+                                                  const struct dxil_mdnode *);
+         resource_array_layout layout = {id, 0, layout_size, range->space};
+         const struct dxil_type *res_type =
+            dxil_module_get_res_type(&ctx->mod, range->kind, range->comp_type,
+                                     4, false /* readwrite */);
+         res_type = dxil_module_get_array_type(&ctx->mod, res_type, count);
+         const struct dxil_mdnode *srv_meta =
+            emit_srv_metadata(&ctx->mod, res_type, "heap_textures", &layout,
+                              range->comp_type, range->kind);
+         if (!srv_meta)
+            return false;
+         util_dynarray_append(&ctx->srv_metadata_nodes, srv_meta);
+         add_resource(ctx, DXIL_RES_SRV_TYPED, range->kind, &layout);
+         range->range_id = id;
+      }
+   }
+   return true;
+}
+
+static const struct dxil_value *
+emit_heap_emulation_handle(struct ntd_context *ctx,
+                           enum dxil_resource_class res_class, unsigned kind,
+                           enum dxil_component_type comp_type, nir_src *src)
+{
+   const struct heap_range *range = find_heap_range(ctx, res_class, kind, comp_type);
+   if (!range || range->range_id == ~0u)
+      return NULL;
+   return emit_createhandle_call(ctx, res_class, 0, UINT_MAX, range->space,
+                                 range->range_id,
+                                 get_src(ctx, src, 0, nir_type_uint32),
+                                 true /*TODO: divergence*/);
+}
