diff --git a/src/microsoft/spirv_to_dxil/spirv_to_dxil.h b/src/microsoft/spirv_to_dxil/spirv_to_dxil.h
index 9285436..6290b15 100644
--- a/src/microsoft/spirv_to_dxil/spirv_to_dxil.h
+++ b/src/microsoft/spirv_to_dxil/spirv_to_dxil.h
@@ -219,8 +219,35 @@ struct dxil_spirv_runtime_conf {
    unsigned input_clip_size;
 
    bool disable_math_refactoring;
+
+   // With lower_to_bindless, if the shader model ends up below 6.6, where
+   // dynamic heap indexing doesn't exist, the heaps are accessed through
+   // unbounded descriptor ranges starting at register 0 instead, one per
+   // resource kind and component type (DXIL enum values), in the register
+   // spaces returned by dxil_spirv_heap_emulation_srv_space and
+   // dxil_spirv_heap_emulation_sampler_space for this base. The descriptor
+   // tables binding them must point to the start of the heaps.
+   uint32_t heap_emulation_register_space_base;
+   // The number of descriptors in each emulation range, 0 for unbounded
+   // ranges. The descriptor tables must declare the same sizes.
+   uint32_t heap_emulation_srv_count;
+   uint32_t heap_emulation_sampler_count;
 };
 
+static inline uint32_t
+dxil_spirv_heap_emulation_srv_space(uint32_t base,
+                                    uint32_t dxil_resource_kind,
+                                    uint32_t dxil_component_type)
+{
+   return base + dxil_resource_kind * 32 + dxil_component_type;
+}
+
+static inline uint32_t
+dxil_spirv_heap_emulation_sampler_space(uint32_t base, bool comparison)
+{
+   return base + (comparison ? 1 : 0);
+}
