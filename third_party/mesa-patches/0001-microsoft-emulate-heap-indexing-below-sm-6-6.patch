diff --git a/src/microsoft/compiler/nir_to_dxil.h b/src/microsoft/compiler/nir_to_dxil.h
index 9890115..61513a8 100644
--- a/src/microsoft/compiler/nir_to_dxil.h
+++ b/src/microsoft/compiler/nir_to_dxil.h
@@ -87,6 +87,18 @@ struct nir_to_dxil_options {
    enum dxil_environment environment;
    enum dxil_shader_model shader_model_max;
    enum dxil_validator_version validator_version_max;
+   /* When the module ends up below SM 6.6, access bindless texture and sampler
+    * handles (heap indices) through unbounded descriptor ranges covering the
+    * whole heap instead of dynamic heap indexing, which needs SM 6.6. Each
+    * range starts at register 0, in a register space derived from
